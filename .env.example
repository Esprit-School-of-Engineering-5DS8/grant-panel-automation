# Committee account used by the admin sign-in form.
GRANT_PANEL_ADMIN_EMAIL=committee@example.org
GRANT_PANEL_ADMIN_PASSWORD=replace-with-a-long-random-secret

# Optional real video transcription provider.
# Keep the real value in the process environment; never commit it.
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Model used to label OCR lines into CV fields (must be available on your Groq account).
GROQ_CV_LABEL_MODEL=qwen/qwen3.8-27b

